---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/sections/Header.astro';
import Hero from '@/components/sections/Hero.astro';
import HowIWork from '@/components/sections/HowIWork.astro';
import Work from '@/components/sections/Work.astro';
import SideProjects from '@/components/sections/SideProjects.astro';
import Now from '@/components/sections/Now.astro';
import Experience from '@/components/sections/Experience.astro';
import Skills from '@/components/sections/Skills.astro';
import Writing from '@/components/sections/Writing.astro';
import Contact from '@/components/sections/Contact.astro';
import Footer from '@/components/sections/Footer.astro';
import SceneIsland from '@/components/three/SceneIsland';
import { site } from '@/config/site';
---

<BaseLayout title={site.name}>
  <Header slot="header" />
  <SceneIsland client:media="(min-width: 48rem)" />
  <Hero />
  <HowIWork />
  <Work />
  <SideProjects />
  <Now />
  <Experience />
  <Skills />
  <Writing />
  <Contact />
  <Footer slot="footer" />
</BaseLayout>
