---
interface Props {
  /** File name in src/assets/diagrams, without `.svg`. */
  slug: string;
  /** Accessible description of the diagram. */
  label: string;
  caption?: string;
}

const { slug, label, caption } = Astro.props;

const diagrams = import.meta.glob<string>('/src/assets/diagrams/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const raw = diagrams[`/src/assets/diagrams/${slug}.svg`];
if (!raw) console.warn(`[Diagram] src/assets/diagrams/${slug}.svg not found; rendering nothing.`);

const escapeAttr = (value: string) => value.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
const svg = raw?.replace(/<svg\b/, `<svg role="img" aria-label="${escapeAttr(label)}"`);
---

{
  svg && (
    <figure class="my-8 border-(length:--border-width) border-border bg-card p-4 text-card-foreground shadow-brutal">
      <div class="[&_svg]:h-auto [&_svg]:w-full" set:html={svg} />
      {caption && <figcaption class="mt-3 font-mono text-sm text-muted-foreground">{caption}</figcaption>}
    </figure>
  )
}
