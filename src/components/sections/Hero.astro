---
import Button from '@/components/ui/Button.astro';
import { hero } from '@/data/hero';
import { tldr } from '@/lib/llms';

const marks = {
  primary: { block: 'bg-primary', text: 'text-primary-foreground' },
  secondary: { block: 'bg-secondary', text: 'text-secondary-foreground' },
};
---

<section id="top" aria-labelledby="hero-title" data-chapter="0" class="scroll-mt-30 px-[clamp(1rem,4vw,3rem)] pt-16 pb-20">
  <div class="mx-auto flex max-w-300 flex-col gap-14">
    <div class="flex flex-wrap items-center gap-x-10 gap-y-12">
      <div class="flex min-w-0 flex-[1_1_36rem] flex-col gap-8">
        <p
          data-m="rise"
          class="inline-flex items-center gap-2.5 self-start border-(length:--border-width-sm) border-border bg-card px-3 py-2 font-mono text-xs font-bold tracking-[0.06em] text-card-foreground uppercase"
        >
          <span aria-hidden="true" class="size-2.5 animate-blink border-(length:--border-width-sm) border-border bg-accent"></span>
          {hero.status}
        </p>
        <h1 id="hero-title" class="text-[clamp(2.75rem,5.8vw,5.25rem)] leading-[0.98] font-bold tracking-[-0.045em]">
          {
            hero.lines.map((line) => (
              <span data-m="line" class="block">
                {line.text}
                {'mark' in line && line.mark && (
                  <>
                    {' '}
                    <span class="relative inline-block px-[0.1em]">
                      <span
                        data-m="hl"
                        aria-hidden="true"
                        class:list={['absolute inset-[0.08em_0_0.02em_0] origin-left border-(length:--border-width) border-border', marks[line.mark.tone].block]}
                      />
                      <span data-m="hltext" class:list={['relative', marks[line.mark.tone].text]}>
                        {line.mark.text}
                      </span>
                    </span>
                  </>
                )}
              </span>
            ))
          }
        </h1>
        <p data-m="rise" class="max-w-[32em] text-[clamp(1.125rem,1.6vw,1.3125rem)] leading-normal text-pretty">{hero.lede}</p>
        <p data-m="rise" class="max-w-[38em] leading-normal text-pretty">
          <span class="mr-2 font-mono text-xs font-bold tracking-[0.06em] uppercase">TL;DR</span>{tldr}
        </p>
        <div data-m="rise" class="flex flex-wrap items-center gap-4">
          <Button href={hero.primaryCta.href}>{hero.primaryCta.label}</Button>
          <Button href={hero.secondaryCta.href} variant="secondary">{hero.secondaryCta.label}</Button>
          <span aria-hidden="true" class="-rotate-4 font-hand text-[1.625rem] leading-none">{hero.note}</span>
        </div>
      </div>

      <figure data-m="rise" class="relative mx-auto min-w-65 flex-[0_1_23.75rem] pt-6 pr-4">
        <div class="rotate-[1.5deg] border-(length:--border-width) border-border bg-card text-card-foreground shadow-brutal">
          <div class="flex aspect-[4/5] items-center justify-center border-b-(length:--border-width) border-border bg-muted">
            <span class="font-mono text-sm font-bold text-muted-foreground">TODO: photo</span>
          </div>
          <figcaption class="flex justify-between gap-3 px-3.5 py-2.5 font-mono text-xs font-bold tracking-[0.04em]">
            {hero.photo.caption.map((part) => <span>{part}</span>)}
          </figcaption>
        </div>
        <span
          aria-hidden="true"
          class="absolute top-0 -left-4 -rotate-7 border-(length:--border-width) border-border bg-primary px-4 pt-1.5 pb-2 font-hand text-[2rem] leading-none text-primary-foreground shadow-brutal-sm"
        >
          {hero.photo.sticker}
        </span>
        <span
          aria-hidden="true"
          class="absolute right-0 bottom-14 rotate-5 border-(length:--border-width-sm) border-border bg-accent px-2.5 py-1.5 font-mono text-xs font-bold tracking-[0.06em] text-accent-foreground"
        >
          {hero.photo.tag}
        </span>
      </figure>
    </div>

    <dl class="grid grid-cols-[repeat(auto-fit,minmax(15rem,1fr))] gap-1 border-(length:--border-width) border-border bg-foreground">
      {
        hero.facts.map((fact) => (
          <div class="flex flex-col gap-1.5 bg-background px-5 py-4 text-foreground">
            <dt class="font-mono text-xs font-bold tracking-[0.06em] uppercase">{fact.label}</dt>
            <dd class="font-medium">
              {fact.value}
              {'aside' in fact && <span class="font-mono text-[0.8125rem]"> {fact.aside}</span>}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<div aria-hidden="true" class="overflow-hidden border-y-(length:--border-width) border-border bg-primary text-primary-foreground">
  <div data-marquee class="flex w-max will-change-transform">
    {
      [...hero.marquee, ...hero.marquee].map((item) => (
        <span class="flex items-center gap-8 py-4.5 pl-8 text-[clamp(1.375rem,3vw,2.25rem)] font-bold tracking-[-0.01em] whitespace-nowrap uppercase">
          {item}
          <span class="size-3.5 bg-primary-foreground" />
        </span>
      ))
    }
  </div>
</div>
