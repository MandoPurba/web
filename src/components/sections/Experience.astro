---
import Section from '@/components/ui/Section.astro';
import Rich from '@/components/ui/Rich.astro';
import { experience } from '@/data/experience';
---

<Section id="experience" chapter={5} label="Experience" tone="muted">
  <Fragment slot="heading">What I've learned on the job.</Fragment>
  {
    experience.map((job) => (
      <div class="flex flex-wrap items-start gap-10">
        <div class="min-w-0 flex-[1_1_17.5rem] border-(length:--border-width) border-border bg-card text-card-foreground shadow-brutal">
          <p class="border-b-(length:--border-width) border-border bg-foreground px-5 py-2.5 font-mono text-xs font-bold tracking-[0.06em] text-background uppercase">
            <time datetime={job.period.start}>{job.period.label}</time>
          </p>
          <div class="flex flex-col gap-3 p-6">
            <h3 class="font-bold text-[1.875rem] leading-none tracking-[-0.03em]">{job.role}</h3>
            <p class="font-mono text-[0.8125rem] leading-normal">@ {job.org}</p>
            <p class="text-[1.0625rem] leading-normal">{job.summary}</p>
          </div>
        </div>
        <ol data-timeline class="relative flex min-w-0 flex-[2_1_32.5rem] flex-col gap-10 pl-14">
          <span aria-hidden="true" class="absolute top-4 bottom-4 left-3.5 w-1 bg-background" />
          <span data-timeline-line aria-hidden="true" class="absolute top-4 bottom-4 left-3.5 w-1 origin-top bg-foreground" />
          {job.lessons.map((lesson, i) => (
            <li class="relative flex flex-col gap-2">
              <span
                data-dot
                data-on="true"
                aria-hidden="true"
                class="absolute top-0.5 -left-13 size-6 border-(length:--border-width) border-border bg-card data-[on=true]:bg-primary"
              />
              <span class="font-mono text-xs font-bold tracking-[0.06em] uppercase">
                Lesson {String(i + 1).padStart(2, '0')} — {lesson.title}
              </span>
              <p class="text-[clamp(1.125rem,1.5vw,1.25rem)] leading-normal text-pretty">
                <Rich text={lesson.body} />
              </p>
            </li>
          ))}
        </ol>
      </div>
    ))
  }
</Section>
